# For docker compose: copy this to .env and replace both secrets.
POSTGRES_USER=nexusforge
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=nexusforge
ACCESS_TOKEN_SECRET=replace_with_at_least_32_random_characters_for_access
REFRESH_TOKEN_SECRET=replace_with_another_at_least_32_random_characters
# Explicitly opt in to the development-only seeded demo account.
DEMO_MODE=false
